# Copy to `.env` at the **monorepo root** (same folder as root package.json).
# Never commit real secrets. Next.js loads this via apps/web/next.config.ts;
# Prisma CLI loads it via packages/database/run-prisma.cjs.

# PostgreSQL connection string
# Phase 19 local cluster example (see docs/runtime-database.md):
# DATABASE_URL="postgresql://koulshy@127.0.0.1:5433/koulshy_taib?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/koulshy_taib?schema=public"

# Signed Admin session cookie (long random string; required for login)
ADMIN_SESSION_SECRET=

# Optional: seed first Admin on `npm run db:seed` (omit both to skip)
ADMIN_SEED_IDENTIFIER=admin@kulshytaib.rest
ADMIN_SEED_PASSWORD=
# Optional: notification provider (Phase 20 — mock only; never sends real messages)
NOTIFICATION_PROVIDER=mock
NOTIFICATION_DEFAULT_CHANNEL=WHATSAPP

# Kitchen WhatsApp (click-to-chat). Digits only, country code, no "+".
# Example Iraq: 9647XXXXXXXXX
# Used for guest "ثبّت الطلب على واتساب" after checkout. Omit to hide that CTA.
KITCHEN_WHATSAPP_E164=

# Required on Vercel for admin image uploads (Storage → Blob → token).
# Locally, uploads go to apps/web/public/uploads/ when this is unset.
BLOB_READ_WRITE_TOKEN=
